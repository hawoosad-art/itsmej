<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for our server IP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">0.0.0.0</domain>
        <domain includeSubdomains="true">hercules-dev.com</domain>
    </domain-config>

    <!-- [V89] base-config OVERRIDES the manifest usesCleartextTraffic flag.
         It was false, so rtsp://192.168.x.x (any LAN IP not listed above)
         was denied cleartext and the Java-side stream preview could never
         connect — while the native GStreamer path (injection) was unaffected.
         This app talks plain rtsp/http to LAN hosts by design: permit. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
